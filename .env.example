VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-public-anon-key"

# Optional compatibility keys used by older code paths
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-public-anon-key"

# Service role key (required for secure server-side seeding). Keep this secret and do NOT commit.
# Example usage: export SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Notes:
# - Copy this file to `.env` locally and fill real values.
# - Never commit secrets. Keep private keys in Cloudflare/R2/Secrets.